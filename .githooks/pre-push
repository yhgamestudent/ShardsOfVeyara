#!/bin/sh
# Git Push 시 DVC 데이터 원격 저장소(Google Drive)로 자동 푸시

if ! command -v dvc >/dev/null 2>&1; then
    echo "==> [DVC Hook Warning] dvc 명령어를 찾을 수 없습니다. DVC 푸시를 건너뜁니다."
    exit 0
fi

echo "==> [DVC Hook] Git Push 감지: Google Drive로 DVC 에셋 푸시 시작 (dvc push)..."
dvc push
status=$?

if [ $status -ne 0 ]; then
    echo "==> [DVC Hook Warning] DVC 에셋 푸시에 실패했으나, Git 소스 코드 푸시는 계속 진행합니다."
    echo "    (Google Drive 인증이나 대용량 에셋 동기화가 필요한 경우 수동으로 'dvc push'를 실행해 주세요.)"
    exit 0
fi

echo "==> [DVC Hook] DVC 에셋 푸시 완료."
exit 0
